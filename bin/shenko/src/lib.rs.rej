+
+/// Start the node inside the host process (Android cdylib, SPEC §24.5).
+///
+/// The foreground service supplies only the app files dir and a port: there is
+/// no argv, no renamed ELF and no fork. The Start inputs are retained on the
+/// first start and must match exactly on every later one, and the selected
+/// installation's Store, stage, schema and frozen-Start custody is verified
+/// before the real runtime starts (see `inprocess_start`). A missing witness
+/// refuses the start instead of serving a guessed generation.
+pub fn run_embedded_start(data_dir: PathBuf, port: u16) -> Result<()> {
+    let (owner, data_dir) = admit_installation(data_dir)?;
+    let frozen = start_inputs::admit(&data_dir, start_inputs::StartRequest::in_process(port))?;
+    let command = frozen.clone().into_command();
+    run_host(command, data_dir, Some(owner), Some(frozen), None)
+}
+
+/// Start the committed successor generation in this same process.
+///
+/// The desktop hand-over `exec`s the selected executable and transfers the
+/// locked owner descriptor. Android has no executable it may `exec`, so the
+/// successor starts in-process while the SAME `RuntimeOwner`, the committed
+/// selector revision and the retained Start inputs are verified again. Without
+/// the retained inputs or any other custody witness the start is refused; the
+/// committed selector stays readable for recovery instead of being served by an
+/// invented runtime.
+#[cfg(target_os = "android")]
+pub(crate) fn run_selected_in_process(
+    data_dir: PathBuf,
+    expected_selector_revision: u64,
+    owner: crate::runtime_owner::RuntimeOwner,
+) -> Result<()> {
+    let data_dir = data_dir.canonicalize()?;
+    owner.verify_path(&data_dir)?;
+    let frozen = start_inputs::require(&data_dir)?;
+    let command = frozen.clone().into_command();
+    run_host(command, data_dir, Some(owner), Some(frozen), Some(expected_selector_revision))
+}
