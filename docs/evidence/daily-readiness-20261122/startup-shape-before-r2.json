  "findings": [
    {
      "code": "store_schema_many_separate_writes",
      "source": "crates/shenko-store/src/store.rs:182 and 1823; crates/shenko-store/src/migrations.rs:5",
      "fact": "SQLite is configured WAL/FULL/FK before initialize_schema. Most schema batches and ALTER helpers execute on the connection without an enclosing explicit transaction. Named-constant CREATE counts describe static reachable statements, not measured SQLite commits or fsync calls.",
      "limits": "The start-to-store-opened interval also includes target validation, directory/slot/CAS setup, publication and installation locks, SQLite open/configuration, all migrations and capability queries. It does not isolate schema duration."
    },
    {
      "code": "cannot_wrap_all_migrations_blindly",
      "source": "crates/shenko-store/src/migrations.rs:72,162,224,292,80,87",
      "fact": "Two conditional migrations open unchecked transactions; two seat migrations issue explicit BEGIN/COMMIT; optional FTS errors are caught. A whole-function outer transaction needs nested ownership/savepoints and preservation of optional-FTS behavior. Keep journal_mode and foreign_keys configuration outside.",
      "proposal": "A narrower first change could group transaction-free schema constants under RAII transactions while preserving current migration ordering, existing ledger/installation identity and FULL durability. Later consolidate the full migration owner after nested steps are made safe."
    },
    {
      "code": "already_atomic_owners",
      "source": "crates/shenko-node/src/lib.rs:511 and 579; crates/shenko-store/src/store.rs:377 and 406",
      "fact": "Fresh Node schema already uses one IMMEDIATE transaction. Subject genesis/head/first-step/root-task/activation extension already share one transaction. Neither is the same many-autocommit-DDL opportunity."
    },
    {
      "code": "home_has_required_publication_boundaries",
      "source": "crates/shenko-seed/src/bootstrap.rs:606,683,708,744,1146; crates/shenko-wasm/src/checkpoint.rs:512,583,1251; crates/shenko-store/src/cas.rs:46",
      "fact": "Fresh home writes preparing manifest, initializes Git, runs a real WASI probe, publishes ready manifest, captures file objects and checkpoint manifest, durably appends journal then publishes head, then records local provisioning. Each CAS seal and metadata publication carries file/directory syncs.",
      "limits": "The observed home interval does not divide WASM compilation/execution, JSON/hash work, filesystem traversal and synchronization. Do not ascribe it to one fsync or remove the preparing/ready and object-before-root boundaries.",
      "proposal": "A future explicit CAS batch publication barrier may coalesce directory synchronization only if every referenced object is durable before checkpoint/head/ledger publication; this is broader than the schema batching change."
    },
    {
      "code": "launch_to_ui_is_multiple_services",
      "source": "bin/shenko/src/runtime_start.rs:140,153,180,204,254,264; bin/shenko/src/runtime_cognition.rs:35",
      "fact": "Model health metadata probing, Node authority establishment, dispatcher reconciliation, native handlers, cognition seeds, context policies and inference services all precede UI startup. Fresh seeds install sequentially; existing seed IDs are already skipped.",
      "limits": "UI log appears in the shutdown window, so it is not a successful startup readiness receipt or an unperturbed latency measurement. No model generation request is present in the retained ledgers."
