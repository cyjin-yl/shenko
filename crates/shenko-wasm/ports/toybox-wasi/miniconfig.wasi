# Toybox miniconfig for WASI preview1 standalone applets.
#
# Consumed by scripts/genconfig.sh via KCONFIG_ALLCONFIG. Lines are the same
# "CONFIG_X=y" / "# CONFIG_X is not set" format kconfig emits; genconfig -n
# starts from allnoconfig and applies these on top.
#
# Selection rule: only applets whose real code paths work under WASI preview1.
# Anything needing fork/exec, sockets, tty control, ownership syscalls, /proc,
# device nodes, or privilege boundaries is excluded — not stubbed to a fake
# pass. The patches/ directory guards the shared lib helpers these applets
# transitively use.

# ---- build topology ----
# Standalone per-applet binaries; no toybox multiplexer, no suid, no help web.
# CONFIG_TOYBOX is not set
# CONFIG_TOYBOX_SUID is not set
# CONFIG_TOYBOX_ZHELP is not set
CONFIG_TOYBOX_FORCE_NOMMU=y
# CONFIG_TOYBOX_FORK is not set
# CONFIG_TOYBOX_NORECURSE is not set

# ---- posix: file core ----
CONFIG_BASENAME=y
CONFIG_CAT=y
CONFIG_CKSUM=y
CONFIG_CRC32=y
CONFIG_CMP=y
CONFIG_COMM=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_CUT=y
CONFIG_DD=y
CONFIG_DIRNAME=y
CONFIG_DU=y
CONFIG_ECHO=y
CONFIG_EXPAND=y
CONFIG_FALSE=y
CONFIG_TRUE=y
CONFIG_HEAD=y
CONFIG_LINK=y
CONFIG_LN=y
CONFIG_LS=y
CONFIG_MKDIR=y
CONFIG_NL=y
CONFIG_OD=y
CONFIG_PASTE=y
CONFIG_PATCH=y
CONFIG_PRINTF=y
CONFIG_PWD=y
CONFIG_RM=y
CONFIG_RMDIR=y
CONFIG_SPLIT=y
CONFIG_TAIL=y
CONFIG_TAR=y
CONFIG_TEE=y
CONFIG_TOUCH=y
CONFIG_TRUNCATE=y
CONFIG_UNLINK=y
CONFIG_WC=y
CONFIG_ARCH=y
CONFIG_UNAME=y
CONFIG_PRINTENV=y
CONFIG_ENV=y
CONFIG_WHICH=y

# ---- posix: text processing ----
CONFIG_GREP=y
CONFIG_EGREP=y
CONFIG_FGREP=y
CONFIG_SED=y
CONFIG_SORT=y
CONFIG_UNIQ=y
CONFIG_FIND=y
CONFIG_FOLD=y
CONFIG_ICONV=y
CONFIG_STRINGS=y
CONFIG_XXD=y
CONFIG_REV=y
CONFIG_TSORT=y
CONFIG_TEST=y
CONFIG_TEST_GLUE=y

# ---- posix: time ----
CONFIG_DATE=y
CONFIG_CAL=y
CONFIG_SLEEP=y
CONFIG_TS=y
CONFIG_USLEEP=y
CONFIG_UPTIME=y

# ---- posix: ids/hashes ----
CONFIG_MD5SUM=y
CONFIG_SHA1SUM=y
CONFIG_SHA224SUM=y
CONFIG_SHA256SUM=y
CONFIG_SHA384SUM=y
CONFIG_SHA512SUM=y
CONFIG_SHA3SUM=y
CONFIG_BASE64=y
CONFIG_BASE32=y
CONFIG_UUIDGEN=y
CONFIG_MCOOKIE=y
CONFIG_FACTOR=y
CONFIG_COUNT=y
CONFIG_SHUF=y
CONFIG_SEQ=y
CONFIG_YES=y

# ---- compression (pure-stdio, no subprocess) ----
CONFIG_GZIP=y
CONFIG_GUNZIP=y
CONFIG_ZCAT=y

# ---- misc safe utils ----
CONFIG_ASCII=y
CONFIG_UNICODE=y
CONFIG_DOS2UNIX=y
CONFIG_UNIX2DOS=y
CONFIG_FMT=y
CONFIG_FSYNC=y
CONFIG_HELP=y
CONFIG_READLINK=y
CONFIG_REALPATH=y
CONFIG_STAT=y
CONFIG_GETCONF=y
