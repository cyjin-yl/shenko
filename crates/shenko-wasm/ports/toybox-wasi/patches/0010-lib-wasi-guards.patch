 // More or less SIG_DFL that runs our atexit list and can siglongjmp.
 void exit_signal(int sig)
 {
+#ifndef __wasi__
   sigset_t sigset;
 
   if (sig) toys.exitval = sig|128;
   sigfillset(&sigset);
   sigprocmask(SIG_BLOCK, &sigset, 0);
+#else
+  // wasi-libc has no sigprocmask()/sigfillset(); the emulated signal layer
+  // serializes handlers anyway, so exiting directly preserves semantics.
+  if (sig) toys.exitval = sig|128;
+#endif
   xexit();
 }
 
