--- a/scripts/genconfig.sh
+++ b/scripts/genconfig.sh
@@ -44,7 +44,7 @@
 }
 
-genconfig > "$GENDIR"/Config.in || { rm "$GENDIR"/Config.in; exit 1; }
+genconfig > "$GENDIR"/Config.in || { "$SHENKO_TOYBOX_RETAIN" "$GENDIR"/Config.in; exit 1; }
 
 # Find names of commands that can be built standalone in these C files
 toys()
 {
@@ -65,7 +65,7 @@
   [ "${FILE/pending//}" != "$FILE" ] && PENDING="$PENDING $NAME" ||
     WORKING="$WORKING $NAME"
 done &&
-echo -e "clean::\n\t@rm -f $WORKING $PENDING" &&
+echo -e "clean::\n\t@\"$SHENKO_TOYBOX_RETAIN\" -f $WORKING $PENDING" &&
 echo -e "list:\n\t@echo $(echo $WORKING | tr ' ' '\n' | sort | xargs)" &&
 echo -e "list_example:\n\t@echo $(echo $EXAMPLE | tr ' ' '\n' | sort | xargs)"&&
 echo -e "list_pending:\n\t@echo $(echo $PENDING | tr ' ' '\n' | sort | xargs)"&&
@@ -79,10 +79,10 @@
   # when $KCONFIG_ALLCONFIG and $KCONFIG_CONFIG are the same, redirect would zap
   if [ "$KCONFIG_ALLCONFIG" -ef "$KCONFIG_CONFIG" ]
   then
-    X=$(mktemp) &&
-    mv "$KCONFIG_ALLCONFIG" $X &&
-    export KCONFIG_ALLCONFIG=$X &&
-    trap "rm -f $X" EXIT || exit 1
+    X=$(mktemp -d) &&
+    X="$X/config" &&
+    cp -- "$KCONFIG_ALLCONFIG" "$X" &&
+    export KCONFIG_ALLCONFIG="$X" || exit 1
   fi
   brun kconfig "$1" > "${KCONFIG_CONFIG:-.config}"
 fi
