 // Prompt with mesg, read password into buf, return 0 for success 1 for fail
 int read_password(char *buf, int buflen, char *mesg)
 {
+#ifdef __wasi__
+  // No terminal echo control exists; read the line plainly and honestly.
+  int i, ret = 1;
+  dprintf(2, "%s", mesg);
+  for (i = 0; i<buflen-1; i++) {
+    if ((ret = read(0, buf+i, 1))<0 || (!ret&&!i)) break;
+    if (!ret || buf[i]=='\n' || buf[i]=='\r') { ret = 0; break; }
+    if (buf[i] == 4 || buf[i] == 3) break;
+    if (buf[i] == 8 || buf[i] == 127) i -= 2-!i;
+  }
+  buf[i*!ret] = 0;
+  return ret;
