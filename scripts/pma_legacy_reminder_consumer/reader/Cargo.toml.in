# Rendered by scripts/pma_legacy_reminder_consumer.py: @CANDIDATE_REPO@ is the
# source tree of the CANDIDATE reader (frozen durable-effects r2 plus the PMA
# refresh hook). This crate links that tree's crates directly.
#
# There is deliberately NO `shenko-broker` / `local_provider` dependency and no
# HTTP stack: the reader cannot construct a provider, so it cannot resend the
# original request whose evidence it inspects. The driver re-checks this
# mechanically against this file.
[package]
name = "shenko-pma-legacy-reminder-reader"
version = "0.0.0"
edition = "2024"
publish = false

[workspace]

[[bin]]
name = "pma-legacy-reminder-reader"
path = "src/main.rs"

[dependencies]
shenko-store = { path = "@CANDIDATE_REPO@/crates/shenko-store" }
shenko-types = { path = "@CANDIDATE_REPO@/crates/shenko-types" }
shenko-kernel = { path = "@CANDIDATE_REPO@/crates/shenko-kernel" }
shenko-memory = { path = "@CANDIDATE_REPO@/crates/shenko-memory" }
shenko-context-policy = { path = "@CANDIDATE_REPO@/crates/shenko-context-policy", features = ["store"] }
anyhow = "1"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
sha2 = "0.10"
tokio = { version = "1", features = ["full"] }
tokio-util = { version = "0.7", features = ["codec", "io"] }
chrono = { version = "0.4", features = ["serde"] }
