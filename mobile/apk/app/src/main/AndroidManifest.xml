<?xml version="1.0" encoding="utf-8"?>
<!--
  Shenko node APK — SPEC §24.5 bundle. This manifest deliberately:
  - *uses* the Shizuku API permission (declaring moe.shizuku.manager.permission
    ourselves is forbidden; the permission belongs to the Shizuku manager app);
  - declares an accessibility service (user-enabled, off by default);
  - declares a dataSync foreground service hosting the in-process Rust node.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android's own installer permission. The user still approves each
         request; this declaration grants nothing by itself. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Granted by the user-installed Shizuku manager; we never declare it. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:name=".ShenkoApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <activity
            android:name=".ShenkoActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Ordinary same-package replacement UI. Private: only this app can
             open it, and only its own notification PendingIntent can deliver
             a correlated system confirmation. -->
        <activity
            android:name=".activation.InstallerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- Durable PackageInstaller status. It never writes activation
             authority and never starts a replacement runtime. -->
        <receiver
            android:name=".activation.InstallerStatusReceiver"
            android:exported="false" />

        <!-- Delivered by the OS to the newly installed package. A restart is
             a recorded request, not a node-readiness claim. -->
        <receiver
            android:name=".activation.PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".ShenkoNodeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".ShenkoAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
