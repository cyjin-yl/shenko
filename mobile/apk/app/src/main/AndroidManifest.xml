<?xml version="1.0" encoding="utf-8"?>
<!--
  Shenko node APK — SPEC §24.5 bundle. This manifest deliberately:
  - *uses* the Shizuku API permission (declaring moe.shizuku.manager.permission
    ourselves is forbidden; the permission belongs to the Shizuku manager app);
  - declares an accessibility service (user-enabled, off by default);
  - declares a dataSync foreground service hosting the in-process Rust node.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Granted by the user-installed Shizuku manager; we never declare it. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:name=".ShenkoApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <service
            android:name=".ShenkoNodeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".ShenkoAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
